{
  "name": "quoteengine-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Make captioned stills, GIFs and clips from a video on your own device. The file is read in the browser and never uploaded.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "ffmpeg-worker": "node scripts/copy-ffmpeg-worker.mjs",
    "dev": "node scripts/copy-ffmpeg-worker.mjs && vite",
    "build": "node scripts/copy-ffmpeg-worker.mjs && vite build",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "0.12.15",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  }
}
